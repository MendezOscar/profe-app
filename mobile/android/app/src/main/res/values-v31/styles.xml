<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ ignora launch_background y usa su propia API de splash:
         cheque blanco sobre el azul de la marca, igual en modo claro y oscuro. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/profe_azul</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/profe_azul</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
